# HEADER: This file is managed by Ansible; changes to this file will be overwritten.
{% macro render_value(value) -%}
{%- if value is sameas true -%}true
{%- elif value is sameas false -%}false
{%- else -%}{{ value }}
{%- endif -%}
{%- endmacro %}

[user]
  email = {{ email }}
  name = {{ fullname }}

{% for section in config %}
[{{ section }}]
{% for item in config[section] %}
  {{ item }} = {{ render_value(config[section][item]) }}
{% endfor %}
{% endfor %}
